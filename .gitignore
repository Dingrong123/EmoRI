# Data is an explicit allowlist: two preprocessed examples + documentation.
# Raw captures, MAT backups, timing reports, and generated outputs stay local.
/data/*
!/data/README.md
!/data/point_cloud/
!/data/IMU_and_GT/
!/data/radar_raw_data/
/data/point_cloud/*
!/data/point_cloud/pypc_1_1.npy
!/data/point_cloud/pypc_1_1_indices.npy
!/data/point_cloud/pypc_2_1.npy
!/data/point_cloud/pypc_2_1_indices.npy
/data/IMU_and_GT/*
!/data/IMU_and_GT/0516env_aligned_imu_1_1.npy
!/data/IMU_and_GT/0516env_aligned_gt_1_1.npy
!/data/IMU_and_GT/0516env_aligned_imu_2_1.npy
!/data/IMU_and_GT/0516env_aligned_gt_2_1.npy
/data/radar_raw_data/*
!/data/radar_raw_data/README.md
